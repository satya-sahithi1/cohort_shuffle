# Copy this file to .env and fill in your values.
# Never commit .env to git.

DATABASE_URL=postgresql+asyncpg://cohort_user:cohort_pass@localhost:5432/cohort_shuffle
SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Google OAuth — create credentials at https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-dummySecretKey1234567890abc
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend URL — backend redirects here after OAuth with ?token=<jwt>
FRONTEND_URL=http://localhost:3000
