# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cohort_shuffle

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add http://localhost:8000/auth/google/callback to Authorised Redirect URIs.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Frontend ──────────────────────────────────────────────────────────────────
# After OAuth the backend redirects to FRONTEND_URL?token=<jwt>
FRONTEND_URL=http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
